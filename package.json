{
  "name": "vietkey-docgen",
  "version": "1.0.0",
  "description": "VietKey AI Document Generator - Tạo tài liệu Word tự động từ Template",
  "main": "./out/main/index.js",
  "author": "VietKey",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "predev": "node -e \"try{require('child_process').execSync('taskkill /F /IM electron.exe',{stdio:'ignore'});}catch(e){}\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "node scripts/pdf-qa-benchmark.mjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docxtemplater": "^3.56.2",
    "fabric": "^7.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.2.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/fabric": "^5.3.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.vietkey.docgen",
    "productName": "VietKey DocGen",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!node_modules"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
